# Server
PORT=3000
NODE_ENV=development

# Database (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumora

# Redis (optional — used by rate limiting / queues when present)
REDIS_URL=redis://localhost:6379

# Auth (required)
JWT_SECRET=change-me-dev-secret-at-least-16-chars
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-16-chars

# Auth tokens (optional — sensible defaults)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Object storage (optional)
S3_BUCKET=
S3_REGION=

# Stellar
STELLAR_NETWORK=testnet

# Stellar asset issuers (optional — USDC has a public-network default)
USDC_ASSET_ISSUER=
EURC_ASSET_ISSUER=
NGNT_ASSET_ISSUER=

# Escrow (optional — required to route payment intents through escrow)
STELLAR_ESCROW_ADDRESS=
STELLAR_ESCROW_CONTRACT_ID=

# Marketplace platform fee in basis points (optional — default 500 = 5%)
PLATFORM_FEE_BPS=500

# Commission change-request cap (optional — default 3)
COMMISSION_MAX_REVISIONS=3

# Payment-intent transaction lifetime in seconds (optional — default 300)
PAYMENT_INTENT_TTL_SECONDS=300

# SMTP (optional — all four must be set together)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# CORS — comma-separated allowed origins.
# Leave empty to reflect the request origin (any origin allowed with credentials).
CORS_ORIGIN=http://localhost:3000
