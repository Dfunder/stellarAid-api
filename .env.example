# Server configuration
NODE_ENV=development
PORT=3000

# Comma-separated bare origins; cross-origin requests are denied when unset.
# CORS_ORIGIN=http://localhost:3001,https://app.stellaraid.example

# Optional integrations (not yet used by the application)
# DATABASE_URL=postgresql://user:password@localhost:5432/stellar_aid
# REDIS_URL=redis://localhost:6379

# Exponential trending-score decay rate per hour (default gives a 24-hour half-life).
# Set to 0 to disable decay.
# TRENDING_DECAY_RATE_PER_HOUR=0.028881
