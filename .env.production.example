# Production environment
NODE_ENV=production
PORT=3000

# Required when NODE_ENV=production. Replace placeholders before deployment.
DATABASE_URL=postgresql://user:password@db:5432/stellar_aid

# Comma-separated bare origins; cross-origin requests are denied when unset.
CORS_ORIGIN=https://app.stellaraid.example,https://admin.stellaraid.example

# Optional integrations
# REDIS_URL=redis://cache:6379
