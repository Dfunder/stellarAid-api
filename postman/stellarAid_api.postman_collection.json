      "item": [
        {
          "name": "Connect Stellar Wallet",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"publicKey\": \"{{clientWallet}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/wallet/connect",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiVersion}}", "wallet", "connect"]
