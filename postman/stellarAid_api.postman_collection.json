    {
      "name": "5. Stellar Payments & Escrow Flow",
      "description": "3-Step On-Chain Escrow Lifecycle: Initiate Escrow -> Submit Signed XDR -> Release Escrow.",
      "item": [
        {
          "name": "Step 1: Initiate Escrow (Build Unsigned XDR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.paymentId) {",
                  "    pm.environment.set(\"paymentId\", jsonData.paymentId);",
                  "    console.log(\"Saved paymentId: \" + jsonData.paymentId);",
                  "}",
                  "if (jsonData.unsignedXdr) {",
                  "    pm.environment.set(\"unsignedXdr\", jsonData.unsignedXdr);",
                  "    console.log(\"Saved unsignedXdr to environment\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientWallet\": \"{{clientWallet}}\",\n  \"amount\": 200,\n  \"assetCode\": \"XLM\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/payments/commissions/{{commissionId}}/escrow",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiVersion}}", "payments", "commissions", "{{commissionId}}", "escrow"]
            },
            "description": "Builds the unsigned Soroban create_escrow transaction XDR and creates a PENDING payment record. Platform calculates 2% fee."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"paymentId\": \"pay-1234-abcd\",\n  \"unsignedXdr\": \"AAAAAgAAAA...\",\n  \"amount\": 200,\n  \"assetCode\": \"XLM\",\n  \"platformFee\": 4.0\n}"
            }
          ]
        },
        {
          "name": "Step 2: Confirm Payment (Submit Signed XDR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"signedXdr\": \"{{signedXdr}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/payments/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiVersion}}", "payments", "confirm"]
            },
            "description": "Submits the client's signed transaction XDR to the Stellar Horizon / Soroban network. Once confirmed on-chain, updates payment to CONFIRMED and moves commission to IN_PROGRESS."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"paymentId\": \"pay-1234-abcd\",\n  \"txHash\": \"5e6789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123\",\n  \"status\": \"CONFIRMED\"\n}"
            }
          ]
        },
        {
          "name": "Step 3: Release Payment to Artist",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/payments/commissions/{{commissionId}}/release",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiVersion}}", "payments", "commissions", "{{commissionId}}", "release"]
            },
            "description": "Triggered when a commission is COMPLETED. Invokes Soroban release_payment on-chain, transferring the net amount to the artist wallet and platform fee to the platform wallet."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
