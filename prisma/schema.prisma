// Prisma schema — lumora data model.
//
// Auth domain: `User`, `RefreshToken`, `EmailVerification`, `PasswordReset`
// use hard deletes — removing a user cascades to its tokens and verification
// records. There is no soft-delete convention for auth data; expired tokens
// are pruned rather than flagged.
//
// Marketplace domain: identity (`User`) and commerce (`Order`) tables are
// delivered by their own changes. Cross-scope references (`userId`,
// `orderId`) are plain indexed String columns instead of Prisma relations so
// every model here migrates cleanly on its own. Wire the relations up once
// those tables land.
//
// Orphaned media cleanup: `Media` rows are only created alongside an upload.
// When an artwork, portfolio item, or deliverable is deleted, its junction
// rows cascade but the `Media` row itself is retained; a background job
// should sweep `Media` rows older than N days that appear in no junction
// table and no `coverMediaId` reference before deleting the object from S3.
//
// Commerce scope note: artwork/product (`Artwork`, `Skill`) and other
// cross-change tables are referenced with plain indexed String columns
// (`buyerId`, `sellerId`, `userId`, `artworkId`, `authorId`, `targetId`,
// `senderId`); references inside this change (Order → Transaction/Review,
// Commission → Transaction/Deliverable/Review,
// Review → ReviewReply/ReviewReport, message threads) are real relations.
//
// DB-level CHECKs that Prisma cannot express in the schema are declared in
// the migration SQL: amounts stay >= 0, `Transaction` links to an order or a
// commission but never both, and `Review.rating` stays within 1–5. Keep them
// in sync when touching those models.
//
// State machines (documented, then enforced in the service layer):
//   OrderStatus:         PENDING → PROCESSING → COMPLETED → REFUNDED
//                                     ↘ FAILED
//   CommissionStatus:    PENDING → ACCEPTED → IN_PROGRESS → DELIVERED → COMPLETED;
//                        any state except COMPLETED may move to CANCELLED/DISPUTED
//   DeliverableStatus:   UPLOADED → SUBMITTED → ACCEPTED | REJECTED
//   ReviewReportStatus:  OPEN → REVIEWING → RESOLVED | DISMISSED
//
// Accountability: money history is immutable — deleting an Order or
// Commission referenced by a Transaction is restricted (Restrict).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ARTIST
  ADMIN
}

/// How a media object is used.
enum MediaType {
  IMAGE
  DIGITAL_FILE
}

/// Marketplace categories for artworks.
enum ArtworkCategory {
  ART
  ILLUSTRATION
  GRAPHIC_DESIGN
  PHOTOGRAPHY
  DIGITAL_PAINTING
  THREE_D_ART
  ANIMATION
  UX_UI
  MUSIC
  WRITING
  OTHER
}

/// Artist verification workflow state.
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Core identity model. `email` and `username` are unique (enforced as unique indexes).
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  username      String   @unique
  role          Role     @default(USER)
  emailVerified Boolean  @default(false)
  bio           String?
  location      String?
  website       String?
  socialLinks   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens      RefreshToken[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]

  @@index([email])
  @@index([username])
}

/// Long-lived refresh token; `token` is unique for direct lookups during rotation.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time email verification links.
model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time password reset links.
model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
/// Assets a contract can be priced in.
enum Asset {
  USDC
  XLM
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionType {
  PURCHASE
  PAYOUT
  FEE
  REFUND
}

enum CommissionStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DeliverableType {
  WIP
  FINAL
}

enum DeliverableStatus {
  UPLOADED
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum ReviewReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

/// Purchase of an artwork. `artworkId` references the Artwork table
/// delivered elsewhere.
model Order {
  id             String        @id @default(uuid())
  buyerId        String
  sellerId       String
  artworkId      String
  amount         Decimal       @db.Decimal(12, 2)
  asset          Asset
  platformFee    Decimal       @db.Decimal(12, 2)
  status         OrderStatus   @default(PENDING)
  idempotencyKey String?
  txHash         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]
  reviews        Review[]

  @@unique([buyerId, idempotencyKey])
  @@index([buyerId])
  @@index([sellerId])
  @@index([artworkId])
  @@index([status])
}

/// Single ledger entry. Links to an order XOR a commission (CHECK 704),
/// never both.
model Transaction {
  id           String          @id @default(uuid())
  orderId      String?
  commissionId String?
  userId       String
  type         TransactionType
  amount       Decimal         @db.Decimal(12, 2)
  asset        Asset
  txHash       String
  network      String
  confirmed    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  commission   Commission?     @relation(fields: [commissionId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([commissionId])
  @@index([userId, type])
  @@index([network, confirmed])
}

/// Custom work contract between a client and an artist.
model Commission {
  id           String           @id @default(uuid())
  clientId     String
  artistId     String
  title        String
  description  String?
  budget       Decimal          @db.Decimal(12, 2)
  asset        Asset
  deadline     DateTime
  status       CommissionStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  transactions Transaction[]
  deliverables Deliverable[]
  reviews      Review[]

  @@index([clientId])
  @@index([artistId])
  @@index([status])
}

/// A version of a commission deliverable — WIP drafts or the FINAL artefact.
model Deliverable {
  id           String            @id @default(uuid())
  commissionId String
  note         String?
  type         DeliverableType
  status       DeliverableStatus @default(UPLOADED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  commission   Commission        @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId, type])
  @@index([status])
}

/// Reputation review. `authorId`/`targetId` reference users delivered
/// elsewhere; `orderId`/`commissionId` come from this change. One review per
/// order and one per commission is enforced by the two DB uniques below
/// (Postgres treats NULLs as distinct, so each constraint independently
/// scopes its own nullable column). Rating constrained to 1–5 in SQL.
model Review {
  id           String         @id @default(uuid())
  orderId      String?
  commissionId String?
  authorId     String
  targetId     String
  rating       Int            @db.SmallInt
  title        String?
  body         String
  edited       Boolean        @default(false)
  createdAt    DateTime       @default(now())
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  commission   Commission?    @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  replies      ReviewReply[]
  reports      ReviewReport[]

  @@unique([orderId])
  @@unique([commissionId])
  @@index([targetId])
  @@index([authorId])
}

model ReviewReply {
  id        String   @id @default(uuid())
  reviewId  String
  body      String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

/// A 1:1 conversation. Participants are validated at the application layer
/// (two distinct users, no self-threads) before a thread is created.
model MessageThread {
  id           String              @id @default(uuid())
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  participants ThreadParticipant[]
  messages     Message[]
}

model ThreadParticipant {
  threadId String
  userId   String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
}

model Message {
  id        String        @id @default(uuid())
  threadId  String
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime      @default(now())
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

/// Polymorphic payloads live in `data` (any JSON shape), keep the queue safe.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

/// Moderation report against a review. Status moves OPEN → REVIEWING →
/// RESOLVED | DISMISSED.
model ReviewReport {
  id         String             @id @default(uuid())
  reviewId   String
  reporterId String
  reason     String
  status     ReviewReportStatus @default(OPEN)
  createdAt  DateTime           @default(now())
  review     Review             @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@index([reviewId])
  @@index([status])
}

/// Stellar public key linked to a user account (one wallet per user).
model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  publicKey String   @unique
  network   String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([publicKey])
  @@index([network])
}

/// Short-lived signing nonce; expires and is consumed after use.
model StellarNonce {
  id        String   @id @default(uuid())
  publicKey String
  nonce     String   @unique
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([publicKey])
}

/// Optional creator profile — not every user has one.
model ArtistProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  bio                String?
  location           String?
  hourlyRate         Decimal?           @db.Decimal(12, 2)
  availability       Boolean            @default(true)
  skills             Json?
  socialLinks        Json?
  coverImage         String?
  avatarUrl          String?
  verified           Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

/// Follow relationship. Enforced unique per (follower, following) pair;
/// self-follows are rejected at the application layer (see service layer).
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

/// Controlled skill taxonomy for artist profiles.
model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  category  String?
  createdAt DateTime @default(now())
}

/// Showcase item (not for sale).
model PortfolioItem {
  id           String           @id @default(uuid())
  userId       String
  title        String
  description  String?
  tags         Json?
  coverMediaId String?
  order        Int              @default(0)
  published    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  media        PortfolioMedia[]

  @@index([userId])
  @@index([userId, published])
}

/// Artwork listed for sale. `category` is an enum; the separate `Category`
/// table carries the browsable taxonomy.
model Artwork {
  id           String          @id @default(uuid())
  userId       String
  title        String
  description  String?
  category     ArtworkCategory
  tags         Json?
  coverMediaId String?
  price        Decimal?        @db.Decimal(12, 2)
  asset        Asset?
  published    Boolean         @default(false)
  sold         Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  media        ArtworkMedia[]
  saves        Save[]

  @@index([userId])
  @@index([category])
  @@index([userId, published])
  @@index([price])
}

/// A user saving/favoriting an artwork. `userId` is a plain indexed column
/// (User is delivered elsewhere, per the cross-scope convention documented
/// at the top of this file); `artworkId` is a real relation since Artwork
/// is defined in this same schema. Unique per (userId, artworkId) so
/// toggling save/unsave is idempotent at the database level too.
model Save {
  id        String   @id @default(uuid())
  userId    String
  artworkId String
  createdAt DateTime @default(now())
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([userId, artworkId])
  @@index([userId])
  @@index([artworkId])
}

/// A user bookmarking an artwork. Toggled (save/unsave), not a like counter.
model Save {
  id        String   @id @default(uuid())
  userId    String
  artworkId String
  createdAt DateTime @default(now())
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([userId, artworkId])
  @@index([userId])
  @@index([artworkId])
}

/// Browsable category taxonomy. One level of nesting (parent → child).
model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  createdAt DateTime   @default(now())

  @@index([parentId])
}

/// Flat tag vocabulary (unique slug).
model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
}

/// Metadata for every uploaded file (S3 bucket/key + dimensions).
///
/// Processed variants (thumbnail, WebP) are their own `Media` rows pointing
/// back at the original via `variantOfId`/`variantLabel`, rather than extra
/// columns on the original — this keeps a variant's own bucket/key/size/
/// dimensions modeled the same way as any other Media row.
model Media {
  id           String             @id @default(uuid())
  userId       String
  type         MediaType
  bucket       String
  key          String             @unique
  mimeType     String
  size         BigInt             @db.BigInt
  width        Int?
  height       Int?
  variantOfId  String?
  variantLabel String?
  createdAt    DateTime           @default(now())
  variantOf    Media?             @relation("MediaVariants", fields: [variantOfId], references: [id], onDelete: Cascade)
  variants     Media[]            @relation("MediaVariants")
  artworks     ArtworkMedia[]
  portfolio    PortfolioMedia[]
  deliverables OrderDeliverable[]

  @@index([userId])
  @@index([variantOfId])
}

/// Artwork ↔ media join with editable sort order.
model ArtworkMedia {
  artworkId String
  mediaId   String
  sort      Int     @default(0)
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([artworkId, mediaId])
  @@index([mediaId])
}

/// Portfolio item ↔ media join with editable sort order.
model PortfolioMedia {
  portfolioItemId String
  mediaId         String
  sort            Int           @default(0)
  portfolioItem   PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  media           Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([portfolioItemId, mediaId])
  @@index([mediaId])
}

/// Deliverable media attached to an order. `orderId` references the Order
/// table delivered elsewhere (plain indexed string until then).
model OrderDeliverable {
  orderId String
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([orderId, mediaId])
  @@index([mediaId])
}
